{
  "name": "website-change-detector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "worker:dev": "tsx watch --env-file=.env src/worker/index.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "cheerio": "1.1.2",
    "diff": "8.0.4",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "next": "15.5.27",
    "nodemailer": "7.0.13",
    "pixelmatch": "7.2.0",
    "playwright": "1.55.1",
    "pngjs": "7.0.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitest/coverage-v8": "3.2.7",
    "happy-dom": "^18.0.1",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
